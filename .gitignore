# 构建产物不入库
*.apk
!apk/ChinesePlayground.apk

# 本地凭据 —— 绝不入库
.git_token
.env
.gradle/
build/
local.properties
.idea/
*.iml

# 签名钥匙 —— 绝不入库（publish.sh 的 sync_main 会 git add -A，整目录一起挡住）
keystore/
*.jks
*.keystore
keystore.properties

# 内容包（由 tools/gen-content.mjs 在 CI 里生成，不入库）
content/

# 热更包与 Pages 发布目录（由 tools/gen-hot.mjs / CI 生成，不入库）
hot/
page/
tmp/

# v1 画风样张备份（不参与构建）
img_v1/
